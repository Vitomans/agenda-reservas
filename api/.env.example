# Copia este archivo como .env y cambia los valores si hace falta.

# Puerto donde escucha la API
PORT=4000

# Dirección del frontend: es el único origen al que CORS le permite usar la API
WEB_URL=http://localhost:3000

# Conexión a PostgreSQL. Este valor sirve con el docker-compose.yml del proyecto.
DATABASE_URL=postgresql://agenda:agenda@localhost:5432/agenda

# Clave para firmar los tokens de sesión. Debe ser larga, aleatoria y secreta (mínimo 32 caracteres).
# Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Clave que comparten la página y la API publicadas (la misma en Render y en Vercel). Con ella, la API solo
# atiende los pedidos que pasan por la página. En local no hace falta: déjala comentada.
# CLAVE_DE_LA_WEB=una-clave-larga-y-aleatoria

# Socios simulados que reservan y cancelan mientras alguien mira la demo, para que se vea el tiempo real.
# En un club de verdad se pone en false.
SIMULAR_CLUB=true

# Correos de confirmación. Sin BREVO_API_KEY los correos solo se anotan en la consola de la API.
# Para enviarlos de verdad: crea una clave en brevo.com (SMTP & API > API Keys) y confirma el remitente.
# BREVO_API_KEY=tu-clave-de-brevo
CORREO_REMITENTE=reservas@volea.example.com

# Asistente con IA. Conversa con Groq (plan gratis, sin tarjeta). Sin la clave, el asistente no atiende.
# Para crear una: console.groq.com > API Keys > Create API Key.
# GROQ_API_KEY=tu-clave-de-groq

# Con la clave de Gemini (plan gratis, sin tarjeta), el asistente busca en la información del club por significado;
# sin ella, por palabras. También la usa `npm run indexar`. Para crear una: aistudio.google.com > Get API key.
# GEMINI_API_KEY=tu-clave-de-gemini

# Asistente "de guion": responde siempre igual, sin preguntarle nada a una IA. Lo usan los tests e2e, y sirve
# para mirar el chat en local sin gastar la cuota de Groq. Con true, no se usan GROQ_API_KEY ni GEMINI_API_KEY.
# ASISTENTE_DE_GUION=true

# El pronóstico del tiempo se le pide a MET Norway (gratis y sin clave). Con true, se usa uno inventado, sin internet:
# lo usan los tests e2e.
# PRONOSTICO_DE_EJEMPLO=true
