# Copia este archivo como .env y cambia los valores si hace falta.

# Puerto donde escucha la API
PORT=4000

# Dirección del frontend: es el único origen al que CORS le permite usar la API
WEB_URL=http://localhost:3000

# Conexión a PostgreSQL. Este valor sirve con el docker-compose.yml del proyecto.
DATABASE_URL=postgresql://agenda:agenda@localhost:5432/agenda

# Clave para firmar los tokens de sesión. Debe ser larga, aleatoria y secreta (mínimo 32 caracteres).
# Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
