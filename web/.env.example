# Copia este archivo como .env.local si necesitas cambiar algo.

# Dirección de la API. La usan el puente de next.config.ts (la página le pasa a la API todo lo que
# pide en /api/...) y la conexión en vivo de Socket.io, que va directo desde el navegador.
# Empieza con NEXT_PUBLIC_ porque el navegador también la necesita.
NEXT_PUBLIC_API_URL=http://localhost:4000
